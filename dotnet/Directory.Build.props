<Project>
  <!-- The one version number for the whole repository lives in VERSION at the repository root.
       It becomes OvsVersion.Current (generated into OpenVersus.Core at build time) and the
       assembly's version, so the client, the update check and the release name cannot drift. -->
  <PropertyGroup>
    <OvsVersionFile>$(MSBuildThisFileDirectory)../VERSION</OvsVersionFile>
    <OvsVersion Condition="Exists('$(OvsVersionFile)')">$([System.IO.File]::ReadAllText('$(OvsVersionFile)').Trim())</OvsVersion>
    <Version Condition="'$(OvsVersion)' != ''">$(OvsVersion)</Version>
    <InformationalVersion Condition="'$(OvsVersion)' != ''">$(OvsVersion)</InformationalVersion>
  </PropertyGroup>

  <Target Name="RequireVersionFile" BeforeTargets="BeforeBuild">
    <Error Condition="'$(OvsVersion)' == ''" Text="VERSION file not found at $(OvsVersionFile); the dotnet tree must be built inside the repository." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The .editorconfig rules run as analyzers during the build. Braces on every control-flow
         body (IDE0011) is an error there; one-line auto-properties and expression bodies are
         allowed by the same file and stay that way. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Trampoline pages are read-execute at rest and only writable while a stub is placed.
       `dotnet publish -p:RwxTrampolines=true` keeps them read-write-execute for their whole
       life, as the C++ client did. -->
  <PropertyGroup Condition="'$(RwxTrampolines)' == 'true'">
    <DefineConstants>$(DefineConstants);OVS_RWX_TRAMPOLINES</DefineConstants>
  </PropertyGroup>
</Project>
